# --- PostgreSQL ---
POSTGRES_USER=vc
POSTGRES_PASSWORD=vc_secret_change_me
POSTGRES_DB=vc_db

# --- Media server ---
# IP, который mediasoup анонсирует в ICE-кандидатах.
# Локальная разработка: 127.0.0.1
# Тест с других устройств в LAN: IP машины
MEDIASOUP_ANNOUNCED_IP=127.0.0.1

HOST_UID=1000
HOST_GID=1000

# --- TURN (coturn, только прод) ---
# Адреса, которые получают клиенты в iceServers при join
STUN_URL=stun:your-domain:3478
TURN_URL=turn:your-domain:3478
# СЕКРЕТ (не логин/пароль!): совпадает с --static-auth-secret coturn.
# Креды клиентам выпускает media-server как HMAC от этого секрета
# (REST API coturn): username = "expiry:peerId", credential = HMAC-SHA1.
TURN_STATIC_AUTH_SECRET=long_random_secret_change_me
